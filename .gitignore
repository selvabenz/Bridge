# ===== Python (engine/) =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
engine/.venv/

# PyInstaller output directories are machine/platform-specific. The two
# named specs below are committed source for reproducible sidecar builds.
engine/build/
engine/dist/
engine/*.spec
!engine/bridge-engine.spec
!engine/bridge-usfm-checker.spec

# ===== Paratext companion plugin (paratext_plugin/) =====
# csc.exe build output — a compiled DLL, not source. See paratext_plugin/build.ps1.
paratext_plugin/build/
paratext_plugin/disabled-*/

# ===== Rust / Tauri (src-tauri/) =====
src-tauri/target/

# Tauri auto-generates JSON schemas here at build time
# (referenced by capabilities/default.json's $schema, but not source)
src-tauri/gen/

# The compiled sidecar binaries are build OUTPUT, not source — each
# platform needs its own, rebuilt from engine/ via PyInstaller. Never
# commit these; they're large, binary, and go stale silently.
src-tauri/binaries/*.exe
src-tauri/binaries/bridge-engine-*
!src-tauri/binaries/README.txt

# Same reasoning: build-sidecars.ps1 copies engine/resources here so
# tauri.conf.json's bundle.resources can ship it — engine/resources is
# the real, tracked source of truth; this is a disposable build-time copy.
src-tauri/resources/
# ... and engine/language_packs, the Language QA packs.
src-tauri/language_packs/

# Stage 3 semantic-mapping source DB (~120MB) exceeds GitHub's 100MB
# single-file push limit and isn't tracked via Git LFS. Install it locally
# via scripts/install_stage3_files.py — see docs/BUILD_LOG.md for the
# teammate setup steps. The small regression SFM fixtures alongside it
# stay tracked (they're inputs to engine/tests/test_semantic_mapping_stage3.py).
engine/resources/semantic_mapping/*.sqlite

# NOTE: Cargo.lock is intentionally NOT ignored — commit it. This is an
# application, not a library, and a committed lockfile is what makes
# `cargo build` reproducible across machines.

# ===== Node / Svelte / Vite =====
node_modules/
dist/
.vite/

# NOTE: package-lock.json is intentionally NOT ignored — commit it for
# the same reproducibility reason as Cargo.lock.

# ===== Secrets — never commit these =====
.env
.env.*
*.pem
*.key
# AppSettings writes to %LOCALAPPDATA%/.translationcore-ai-bridge/ or
# ~/.translationcore-ai-bridge/ outside this repo by design (see
# tc_ai_bridge/secret_store.py) — this entry is a safety net only, in
# case a local settings.json ever ends up inside the repo by accident.
settings.json

# ===== OS / editor noise =====
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ===== Test fixtures created at runtime (never source) =====
# If you ever point a fixture-building test at a path inside the repo
# instead of tmp_path, this catches the companion dir it would create.
.apps/translationCoreAI/
.pytest-tmp/
.test-temp-*/
test-temp-*/

# ===== Language QA benchmark full results =====
# They quote Scripture and review text; only benchmark/baseline.json and the
# table in docs/LANGUAGE_QA_BENCHMARK.md are committed.
benchmark/results/
