 "inline": false,
 "title": {
  "ta": "குறிப்பு முடிவுக்கு முன் இடைவெளி (குறியீட்டு வடிவமைப்பு)",
  "en": "Markup: space before a note's end marker"
 },
 "message": {
  "en": "Markup formatting, not a text error: a space before the closing note marker. Removing it does not change the verse text."
 },
 "rationale": "No space before \\f* or \\x*",
 "match": {
  "type": "regex",
  "on": "raw",
  "pattern": "(?P<span> +)\\\\[fx]\\*"
 },
 "fix": {
  "type": "replace",
  "text": ""
 },
